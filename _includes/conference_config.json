{%- comment -%}
  Settings and translated strings of the JavaScript modules, inlined into
  every page (no extra request before the modules start)
{%- endcomment -%}
{%- assign lang = site.data.lang[site.conference.lang] -%}
{
    "baseurl": {{ site.baseurl | jsonify }},
    "edition": {{ edition | jsonify }},
    "edition_current": {{ edition_current | jsonify }},

    {%- include get_location_config.html -%}
    {%- if location_map %}
    "map": {
        "map_provider": {{ location_map.map_provider | default: 'OpenStreetMap.Mapnik' | jsonify }},
        "home_coord": [{{ location_map.home_coord | default: '47.3744489, 8.5410422' }}],
        "default_zoom": {{ location_map.default_zoom | default: 17 }}
        {%- if location_map.script %},
        "script": {{ location_map.script | prepend: '/assets/js/' | prepend: site.baseurl | jsonify }}
        {%- endif %}
    },
    {%- endif %}

    {% if edition_live -%}
    "live": {
        "timezone": {{ site.timezone | jsonify }},
        "days": [
            {%- for d in edition_program.days %}
            {
                {%- include get_day_hash.html %}
                "name": {{ day_name | jsonify }},
                "date": {{ d.date | jsonify }}
            }{%- unless forloop.last -%},{%- endunless %}
            {%- endfor %}
        ]
    },
    {%- endif %}

    {% if edition_live.streaming.enable -%}
    "stream": {
        "pause": {{ edition_live.streaming.pause | default: 60 }},
        "prepend": {{ edition_live.streaming.prepend | default: 5 }},
        "extend": {{ edition_live.streaming.extend | default: 5 }}
    },
    {%- endif %}

    {% if site.conference.pwa -%}
    "pwa": {
        "enable": {{ site.conference.pwa.enable | default: false }}
    },
    {%- endif %}

    "lang": {
        "map": {
            "focus_conf": {{ lang.location.focus_conf | default: "Center map on conference location" | jsonify }},
            "focus_me": {{ lang.location.focus_me | default: "Show me where I am" | jsonify }}
        },
        "live": {
            "time": {
                "soon": {{ lang.live.time.soon | default: "soon" | jsonify }},
                "now": {{ lang.live.time.now | default: "now" | jsonify }},
                "in": {{ lang.live.time.in | default: "in" | append: " " | jsonify }},
                "since": {{ lang.live.time.since | default: "since" | append: " " | jsonify }},
                "weeks": {{ lang.live.time.weeks | default: "weeks" | jsonify }},
                "week": {{ lang.live.time.week | default: "week" | jsonify }},
                "days": {{ lang.live.time.days | default: "days" | jsonify }},
                "day": {{ lang.live.time.day | default: "day" | jsonify }},
                "hours": {{ lang.live.time.hours | default: "hours" | jsonify }},
                "hour": {{ lang.live.time.hour | default: "hour" | jsonify }},
                "minutes": {{ lang.live.time.minutes | default: "minutes" | jsonify }},
                "minute": {{ lang.live.time.minute | default: "minute" | jsonify }}
            }
        },
        "stream": {
            "pre_stream": {{ lang.live.pre_stream | default: "Live stream has not started yet." | jsonify }},
            "post_stream": {{ lang.live.post_stream | default: "Live stream has ended." | jsonify }},
            "pause_stream": {{ lang.live.pause_stream | default: "Live stream is currently paused." | jsonify }}
        }
    }
}
